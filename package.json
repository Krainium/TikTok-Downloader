{
  "name": "tiktok-downloader",
  "version": "1.0.0",
  "description": "Tiktok Video and Image Downloader — native TypeScript engine with a CLI menu and a React web UI",
  "type": "module",
  "bin": {
    "tiktok-dl": "dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "web": "npm run web:build && tsx frontend/server.ts",
    "web:serve": "tsx frontend/server.ts",
    "web:build": "vite build -c frontend/vite.config.ts",
    "web:dev": "vite -c frontend/vite.config.ts",
    "web:typecheck": "tsc -p frontend/tsconfig.json --noEmit"
  },
  "keywords": [
    "tiktok",
    "downloader",
    "cli",
    "react",
    "video",
    "slideshow"
  ],
  "author": "Krainium",
  "license": "MIT",
  "dependencies": {
    "@vercel/blob": "^2.6.1",
    "https-proxy-agent": "^7.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.61.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}
